<Window x:Class="SnapBerry.App.Editor.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon" xmlns:editor="clr-namespace:SnapBerry.App.Editor" Title="SnapBerry" Width="1240" Height="820" MinWidth="720" MinHeight="500" Background="{DynamicResource Theme.WindowBackground}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <!-- 화면 구성: 도구 속성을 통합한 리본, 크기 조절 가능한 이력/편집 영역, 상태 표시줄 순서다. -->
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ButtonStyles.xaml"/><ResourceDictionary Source="ScrollBarStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <r:RibbonControlSizeDefinition x:Key="CompactPropertySize" ImageSize="Small" IsLabelVisible="True"/>
  <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}"><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="8,2"/><Setter Property="Margin" Value="3,0"/><Setter Property="Background" Value="{DynamicResource Theme.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme.InputBorder}"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource PurpleComboBoxStyle}"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="4,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <!-- 기본 ListBox 템플릿의 비활성 흰색 배경 대신 테마 배경을 유지한다. 항목의 비활성 표시는 아래 스타일이 담당한다. -->
  <Style x:Key="HistoryListStyle" TargetType="ListBox">
   <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
     <ScrollViewer x:Name="PART_ScrollViewer" Padding="{TemplateBinding Padding}" Focusable="False"><ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/></ScrollViewer>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
   <EventSetter Event="Loaded" Handler="HistoryItemLoaded"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="2,1"/><Setter Property="Padding" Value="2,0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="HistoryItemChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistoryItemChrome" Property="Background" Value="{DynamicResource Theme.Hover}"/><Setter TargetName="HistoryItemChrome" Property="BorderBrush" Value="{DynamicResource Theme.Selected}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="HistoryItemChrome" Property="Background" Value="{DynamicResource Theme.Selected}"/><Setter TargetName="HistoryItemChrome" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HistoryItemChrome" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- 이력 항목은 썸네일과 경량 메타데이터만 표시하며 우클릭 메뉴는 코드에서 연결한다. -->
  <DataTemplate x:Key="CaptureItem">
   <Grid x:Name="CaptureItemRoot" Margin="3,6"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid x:Name="ThumbnailHost" Width="64" Height="48">
     <Border Background="{DynamicResource Theme.Thumbnail}" BorderBrush="{DynamicResource Theme.InputBorder}" BorderThickness="1"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
    </Grid>
    <StackPanel Grid.Column="1" Margin="8,4,0,0"><TextBlock Text="{Binding Caption}" ToolTip="{Binding Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" Foreground="{DynamicResource Theme.MutedText}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
   </Grid>
  </DataTemplate>
 </ResourceDictionary></Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <editor:CompactRibbon x:Name="MainRibbon" Grid.Row="1" Background="{DynamicResource Theme.Ribbon}" BorderBrush="{DynamicResource Theme.Border}" editor:RibbonThemeChrome.DarkMode="{DynamicResource Theme.IsDark}" IsMinimized="False">
   <r:Ribbon.ApplicationMenu><r:RibbonApplicationMenu Visibility="Collapsed"/></r:Ribbon.ApplicationMenu>
   <r:RibbonTab Header="홈">
    <editor:ThemedRibbonGroup Header="이미지">
     <r:RibbonButton x:Name="OpenImageButton" Label="이미지 열기" ToolTip="이미지 열기 (Ctrl+O)" Command="{x:Static ApplicationCommands.Open}"/>
     <r:RibbonButton x:Name="PasteImageButton" Label="이미지 붙여넣기" ToolTip="현재 이미지 위에 붙여넣기 (Ctrl+V). 이미지가 없으면 새로 엽니다." Command="{x:Static ApplicationCommands.Paste}"/>
    </editor:ThemedRibbonGroup>
    <editor:ThemedRibbonGroup Header="캡처">
     <r:RibbonButton x:Name="RegionCaptureButton" Label="영역 캡처" Tag="Region" ToolTip="영역 캡처" Click="CaptureClick"/>
     <r:RibbonButton x:Name="WindowCaptureButton" Label="창 캡처" Tag="Window" ToolTip="창 캡처" Click="CaptureClick"/>
     <r:RibbonButton x:Name="DesktopCaptureButton" Label="전체 화면 캡처" Tag="Desktop" ToolTip="전체 화면 캡처" Click="CaptureClick"/>
    </editor:ThemedRibbonGroup>
    <editor:ThemedRibbonGroup x:Name="ToolsPanel" Header="그리기">
     <r:RibbonToggleButton Label="선택" Tag="Select" IsChecked="True" ToolTip="선택" Click="ToolClick"/>
     <r:RibbonToggleButton Label="화살표" Tag="Arrow" ToolTip="화살표" Click="ToolClick"/>
     <r:RibbonToggleButton Label="텍스트" Tag="Text" ToolTip="텍스트" Click="ToolClick"/>
     <r:RibbonToggleButton Label="사각형" Tag="Rectangle" ToolTip="사각형" Click="ToolClick"/>
     <r:RibbonToggleButton Label="모자이크" Tag="Mosaic" ToolTip="모자이크" Click="ToolClick"/>
     <r:RibbonToggleButton Label="번호" Tag="Number" ToolTip="번호" Click="ToolClick"/>
     <r:RibbonToggleButton Label="스티커" Tag="Sticker" ToolTip="스티커" Click="ToolClick"/>
     <r:RibbonToggleButton x:Name="MagicWandButton" Label="배경 지우개" Tag="MagicWand" ToolTip="색상을 클릭해 선택하고 Delete로 지웁니다. 색상 범위와 비슷한 색 모두 선택을 조절할 수 있습니다." Click="ToolClick"/>
     <r:RibbonToggleButton Label="자르기" Tag="Crop" ToolTip="이미지 모서리를 드래그하여 자르기" Click="ToolClick"/>
    </editor:ThemedRibbonGroup>
    <!-- 속성은 리본 안에 배치한다. 좁은 창에서는 리본 그룹의 기본 접힘 메뉴로 접근한다. -->
    <editor:ThemedRibbonGroup x:Name="PropertiesGroup" Header="속성" Visibility="Collapsed">
     <editor:ThemedRibbonGroup.GroupSizeDefinitions>
      <r:RibbonGroupSizeDefinition><r:RibbonControlSizeDefinition/></r:RibbonGroupSizeDefinition>
      <r:RibbonGroupSizeDefinition IsCollapsed="True"/>
     </editor:ThemedRibbonGroup.GroupSizeDefinitions>
     <WrapPanel x:Name="PropertiesPanel" MaxWidth="210" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0">
      <StackPanel x:Name="MagicWandControls" Visibility="Collapsed" MaxWidth="156">
       <StackPanel Orientation="Horizontal" Height="20">
        <TextBlock Text="색상 범위" VerticalAlignment="Center"/><Slider x:Name="MagicWandTolerance" Minimum="0" Maximum="100" Value="15" Width="60" Height="20" Margin="4,0,0,0" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource PurpleSliderStyle}" ValueChanged="MagicWandOptionsChanged" ToolTip="높일수록 비슷한 색까지 함께 선택합니다." AutomationProperties.Name="색상 범위"/><TextBlock Text="{Binding Value, ElementName=MagicWandTolerance, StringFormat={}{0:0}%}" VerticalAlignment="Center" Margin="4,0"/>
       </StackPanel>
       <CheckBox x:Name="MagicWandGlobal" Content="비슷한 색 모두 선택" Margin="0,2" Checked="MagicWandOptionsChanged" Unchecked="MagicWandOptionsChanged"/>
       <Button x:Name="DeleteMagicWandButton" Content="선택 영역 지우기" Height="24" Margin="0" HorizontalAlignment="Left" Click="DeleteMagicWandClick" ToolTip="선택한 픽셀을 투명하게 지웁니다. Delete 키도 사용할 수 있습니다."/>
      </StackPanel>
      <StackPanel x:Name="CurrentColorControls" Orientation="Horizontal" VerticalAlignment="Center">
       <r:RibbonMenuButton x:Name="ColorMenuButton" Label="색상" Height="32" ControlSizeDefinition="{StaticResource CompactPropertySize}" ToolTip="색상 선택" KeyTip="C">
        <r:RibbonMenuItem StaysOpenOnClick="True">
         <r:RibbonMenuItem.Header><StackPanel>
          <StackPanel Orientation="Horizontal" Margin="4,4,4,10"><Rectangle x:Name="CurrentColorSwatch" Width="18" Height="18" Stroke="{DynamicResource Theme.SecondaryText}" StrokeThickness="1"/><TextBlock x:Name="CurrentColorText" Margin="8,0" VerticalAlignment="Center" FontFamily="Consolas"/></StackPanel>
          <StackPanel x:Name="ColorControls" IsEnabled="{Binding IsEnabled, ElementName=CurrentColorControls}" Orientation="Horizontal"><Button Tag="#E83F56" ToolTip="빨강" Click="ColorClick"><Ellipse Width="15" Height="15" Fill="#E83F56"/></Button><Button Tag="#D55E00" ToolTip="주홍" Click="ColorClick"><Ellipse Width="15" Height="15" Fill="#D55E00"/></Button><Button Tag="#009E73" ToolTip="청록" Click="ColorClick"><Ellipse Width="15" Height="15" Fill="#009E73"/></Button><Button Tag="#0072B2" ToolTip="파랑" Click="ColorClick"><Ellipse Width="15" Height="15" Fill="#0072B2"/></Button><Button Tag="#CC79A7" ToolTip="자홍" Click="ColorClick"><Ellipse Width="15" Height="15" Fill="#CC79A7"/></Button><Button Tag="#000000" ToolTip="검정" Click="ColorClick"><Ellipse Width="15" Height="15" Fill="#000000"/></Button></StackPanel>
          <Button x:Name="ColorPickerButton" IsEnabled="{Binding IsEnabled, ElementName=CurrentColorControls}" Content="다른 색상…" Margin="3,10,3,4" ToolTip="색상 직접 선택" Click="PickColorClick"/>
         </StackPanel></r:RibbonMenuItem.Header>
        </r:RibbonMenuItem>
       </r:RibbonMenuButton>
      </StackPanel>
      <StackPanel x:Name="ThicknessControls" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
       <r:RibbonMenuButton x:Name="ThicknessMenuButton" Label="두께 3px" Height="32" ControlSizeDefinition="{StaticResource CompactPropertySize}" ToolTip="선 두께" KeyTip="W">
        <r:RibbonMenuItem StaysOpenOnClick="True"><r:RibbonMenuItem.Header><StackPanel Margin="6">
         <TextBlock Text="선 두께" Margin="0,0,0,8"/><Slider x:Name="ThicknessSlider" IsEnabled="{Binding IsEnabled, ElementName=ThicknessControls}" Style="{StaticResource PurpleSliderStyle}" Width="160" Minimum="1" Maximum="12" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ThicknessChanged" AutomationProperties.Name="선 두께"/>
        </StackPanel></r:RibbonMenuItem.Header></r:RibbonMenuItem>
       </r:RibbonMenuButton>
      </StackPanel>
      <StackPanel x:Name="LineStyleControls" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0" Visibility="Collapsed"><ComboBox x:Name="LineStyleBox" Width="140" ToolTip="선 모양" AutomationProperties.Name="선 모양" SelectionChanged="LineStyleChanged"/></StackPanel>
      <StackPanel x:Name="FontControls" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0"><TextBlock Text="글자" VerticalAlignment="Center"/><ComboBox x:Name="FontSizeBox" Width="72" IsEditable="True" IsTextSearchEnabled="False" SelectedIndex="1" ToolTip="글자 크기" SelectionChanged="FontChanged" PreviewKeyDown="FontSizeKeyDown" LostKeyboardFocus="FontSizeLostFocus"><ComboBoxItem Content="16"/><ComboBoxItem Content="24"/><ComboBoxItem Content="32"/><ComboBoxItem Content="48"/><ComboBoxItem Content="64"/></ComboBox></StackPanel>
      <StackPanel x:Name="MosaicControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="블록" VerticalAlignment="Center"/><Slider x:Name="MosaicSlider" Style="{StaticResource PurpleSliderStyle}" Width="130" Minimum="4" Maximum="64" Value="12" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" VerticalAlignment="Center" ValueChanged="MosaicChanged"/></StackPanel>
      <StackPanel x:Name="NumberControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"><ComboBox x:Name="NumberModeBox" Width="80" SelectedIndex="0" SelectionChanged="NumberModeChanged"><ComboBoxItem Content="1, 2, 3"/><ComboBoxItem Content="a, b, c"/><ComboBoxItem Content="A, B, C"/></ComboBox><TextBox x:Name="NextNumberBox" Style="{StaticResource PurpleTextBoxStyle}" Width="65" Text="1" Height="30" Padding="6" Margin="5,0" ToolTip="다음 순번" LostKeyboardFocus="NextNumberChanged" KeyDown="NextNumberKeyDown"/></StackPanel>
      <Button x:Name="NumberTextColorButton" Content="A" Visibility="Collapsed" ToolTip="번호 글자색 흰색 또는 검정" Click="NumberTextColorClick"/>
      <Button x:Name="StickerChooseButton" Content="스티커 선택" Visibility="Collapsed" Click="ChooseStickerClick"/>
     </WrapPanel>
    </editor:ThemedRibbonGroup>
    <editor:ThemedRibbonGroup Header="편집">
     <r:RibbonButton x:Name="UndoButton" Label="실행 취소" ToolTip="실행 취소" Click="UndoClick"/>
     <r:RibbonButton x:Name="RedoButton" Label="다시 실행" ToolTip="다시 실행" Click="RedoClick"/>
     <r:RibbonButton x:Name="DeleteButton" Label="삭제" ToolTip="선택 주석 삭제" Click="DeleteAnnotationClick"/>
     <r:RibbonButton x:Name="EditButton" Label="내용 편집" ToolTip="선택 주석 내용 편집" Click="EditAnnotationClick"/>
    </editor:ThemedRibbonGroup>
    <editor:ThemedRibbonGroup Header="내보내기">
     <r:RibbonButton x:Name="CopyButton" Label="복사" ToolTip="클립보드 복사" Click="CopyClick"/>
     <r:RibbonButton x:Name="SaveButton" Label="이미지 파일 저장" ToolTip="이미지 파일 저장 (Ctrl+S)" Click="SaveClick"/>
    </editor:ThemedRibbonGroup>
    <editor:ThemedRibbonGroup x:Name="SettingsGroup" Header="설정"><r:RibbonButton x:Name="RibbonSettings" Label="설정" ToolTip="설정" Click="SettingsClick"/><r:RibbonButton x:Name="RibbonAbout" Label="정보" ToolTip="개발 버전 및 만든이" Click="AboutClick"/></editor:ThemedRibbonGroup>
   </r:RibbonTab>
   <r:RibbonTab Header="보기">
    <editor:ThemedRibbonGroup Header="확대 및 축소"><r:RibbonButton x:Name="RibbonZoomOut" Label="축소" Click="ZoomOutClick"/><r:RibbonButton x:Name="RibbonZoomIn" Label="확대" Click="ZoomInClick"/><r:RibbonButton x:Name="RibbonFit" Label="창에 맞춤" Click="FitClick"/></editor:ThemedRibbonGroup>
    <editor:ThemedRibbonGroup Header="이력"><r:RibbonButton x:Name="RibbonHistory" Label="목록 표시" Click="ToggleHistoryClick"/></editor:ThemedRibbonGroup>
   </r:RibbonTab>
  </editor:CompactRibbon>
  <Grid x:Name="WorkspaceGrid" Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="230" MinWidth="170"/><ColumnDefinition x:Name="HistorySplitterColumn" Width="6"/><ColumnDefinition Width="*" MinWidth="200"/></Grid.ColumnDefinitions>
<Border x:Name="HistoryPanel" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,1,0">
 <Grid><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="14,0,8,0"><TextBlock Text="캡처 이력" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
  <Grid x:Name="HistorySearchPanel" Grid.Row="1" Margin="8,0,8,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="HistorySearchBox" Style="{StaticResource PurpleTextBoxStyle}" Height="32" Padding="7,3" VerticalContentAlignment="Center" ToolTip="이름 또는 표시된 날짜로 검색" AutomationProperties.Name="캡처 이력 이름 또는 날짜 검색" TextChanged="HistorySearchChanged"/>
   <TextBlock Text="이름·날짜 검색" Foreground="{DynamicResource Theme.MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <Button Grid.Column="1" Content="×" ToolTip="검색 지우기" AutomationProperties.Name="검색 지우기" Click="ClearHistorySearchClick"/>
  </Grid>
  <ListBox x:Name="HistoryList" Grid.Row="2" Style="{StaticResource HistoryListStyle}" HorizontalContentAlignment="Stretch" SelectionMode="Extended" BorderThickness="0" Background="{DynamicResource Theme.Surface}" ItemTemplate="{StaticResource CaptureItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.ScrollChanged="HistoryScrollChanged" VirtualizingPanel.IsVirtualizing="True" PreviewMouseLeftButtonUp="HistorySingleClick" KeyDown="HistoryKeyDown"/>
  <TextBlock x:Name="HistoryEmptyText" Grid.Row="2" Text="캡처 이력이 없습니다." Visibility="Collapsed" Foreground="{DynamicResource Theme.MutedText}" TextWrapping="Wrap" Margin="14,12" IsHitTestVisible="False"/>
 </Grid>
</Border>
   <GridSplitter x:Name="HistorySplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" KeyboardIncrement="10" Background="{DynamicResource Theme.InputBorder}" Cursor="SizeWE" ToolTip="이력 영역 너비 조절"/>
   <Grid Grid.Column="2"><ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="25" Background="{DynamicResource Theme.Canvas}"><Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center"/></ScrollViewer>
    <Grid x:Name="EmptyEditorState" Background="{DynamicResource Theme.Canvas}"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="32,48,32,32">
     <StackPanel MaxWidth="420" VerticalAlignment="Center">
      <Image Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,16" Source="{Binding LargeImageSource,ElementName=RegionCaptureButton}"/>
      <TextBlock Text="이미지를 열거나 캡처해 보세요" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" TextWrapping="Wrap"/>
      <TextBlock Text="새로 캡처하기" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" Margin="0,24,0,6"/>
      <TextBlock x:Name="EmptyCaptureHint" Text="상단의 영역 캡처, 창 캡처, 전체 화면 캡처 중 하나를 선택하세요." FontSize="14" Foreground="{DynamicResource Theme.SecondaryText}" TextWrapping="Wrap" LineHeight="23"/>
      <Button x:Name="EmptyRegionCaptureButton" Tag="Region" Click="CaptureClick" HorizontalAlignment="Left" Height="38" MinWidth="130" Margin="0,14,0,0" Padding="12,4" Background="{DynamicResource Theme.Hover}" BorderBrush="{DynamicResource Theme.Accent}" Foreground="{DynamicResource Theme.AccentText}" ToolTip="영역을 선택해 새 캡처 시작"><StackPanel Orientation="Horizontal"><Image Width="20" Height="20" Source="{Binding SmallImageSource,ElementName=RegionCaptureButton}" Margin="0,0,8,0"/><TextBlock Text="영역 캡처" FontSize="14" VerticalAlignment="Center"/></StackPanel></Button>
      <TextBlock Text="이전 캡처 편집하기" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" Margin="0,20,0,6"/>
      <TextBlock x:Name="EmptyHistoryHint" Text="왼쪽 캡처 이력에서 이미지를 클릭하면 다시 편집할 수 있습니다." FontSize="14" Foreground="{DynamicResource Theme.SecondaryText}" TextWrapping="Wrap" LineHeight="23"/>
      <TextBlock Text="기존 이미지는 상단의 이미지 열기(Ctrl+O) 또는 이미지 붙여넣기(Ctrl+V)로 편집할 수 있습니다." FontSize="14" Foreground="{DynamicResource Theme.SecondaryText}" TextWrapping="Wrap" LineHeight="23" Margin="0,20,0,0"/>
     </StackPanel>
    </ScrollViewer></Grid>
    <Button x:Name="HistoryToggleButton" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="이력 목록 접기 또는 펼치기" Margin="4" Click="ToggleHistoryClick"><Image Width="20" Height="20" Source="{Binding SmallImageSource,ElementName=RibbonHistory}"/></Button></Grid>
  </Grid>
  <Border Grid.Row="4" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="준비" Foreground="{DynamicResource Theme.SecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ImageSizeButton" Content="이미지 없음" Height="24" Margin="0,0,12,0" Foreground="{DynamicResource Theme.Accent}" ToolTip="이미지 크기 변경" Click="ResizeImageClick" IsEnabled="False"/><Button Content="−" Height="24" ToolTip="축소" Click="ZoomOutClick"/><TextBlock x:Name="ZoomText" Text="100%" Width="55" VerticalAlignment="Center" TextAlignment="Center"/><Button Content="+" Height="24" ToolTip="확대" Click="ZoomInClick"/><Button Content="맞춤" Height="24" ToolTip="창에 맞춤" Click="FitClick"/></StackPanel></Grid></Border>
 </Grid>
</Window>
