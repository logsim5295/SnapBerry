<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:editor="clr-namespace:SnapBerry.App.Editor">
 <!-- 이력과 이미지 영역의 스크롤바를 통일한다. 가로/세로 방향에 따라 Track 배치와 명령을 전환한다. -->
 <Style x:Key="PurpleScrollArrow" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
   <Border x:Name="ArrowChrome" Background="Transparent" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="{DynamicResource Theme.Selected}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="{DynamicResource Theme.ScrollPressed}"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PurpleScrollPage" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ScrollBar">
  <Setter Property="editor:ScrollBarMenuTheme.Enabled" Value="True"/>
  <Setter Property="Width" Value="14"/><Setter Property="MinWidth" Value="14"/><Setter Property="Background" Value="{DynamicResource Theme.Hover}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
   <Border x:Name="ScrollChrome" Background="{TemplateBinding Background}" CornerRadius="5"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <RepeatButton x:Name="LineDecrease" Grid.Column="1" Grid.Row="0" Style="{StaticResource PurpleScrollArrow}" Command="{x:Static ScrollBar.LineUpCommand}"><TextBlock x:Name="DecreaseGlyph" Text="&#xE70E;" FontFamily="Segoe Fluent Icons" FontSize="9"/></RepeatButton>
    <Track x:Name="PART_Track" Grid.Row="1" Grid.Column="1" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
     <Track.DecreaseRepeatButton><RepeatButton x:Name="PageDecrease" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource PurpleScrollPage}"/></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton x:Name="PageIncrease" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource PurpleScrollPage}"/></Track.IncreaseRepeatButton>
     <Track.Thumb><Thumb MinWidth="8" MinHeight="8" Background="{DynamicResource Theme.Accent}"><Thumb.Template><ControlTemplate TargetType="Thumb">
      <Border x:Name="ThumbChrome" Margin="2" CornerRadius="5" Background="{TemplateBinding Background}"/>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Theme.AccentHover}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Theme.AccentText}"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    </Track>
    <RepeatButton x:Name="LineIncrease" Grid.Column="1" Grid.Row="2" Style="{StaticResource PurpleScrollArrow}" Command="{x:Static ScrollBar.LineDownCommand}"><TextBlock x:Name="IncreaseGlyph" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="9"/></RepeatButton>
   </Grid></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="Orientation" Value="Horizontal">
     <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
     <Setter TargetName="LineDecrease" Property="Grid.Row" Value="1"/><Setter TargetName="LineDecrease" Property="Grid.Column" Value="0"/><Setter TargetName="LineDecrease" Property="Command" Value="{x:Static ScrollBar.LineLeftCommand}"/><Setter TargetName="DecreaseGlyph" Property="Text" Value="&#xE76B;"/>
     <Setter TargetName="LineIncrease" Property="Grid.Row" Value="1"/><Setter TargetName="LineIncrease" Property="Grid.Column" Value="2"/><Setter TargetName="LineIncrease" Property="Command" Value="{x:Static ScrollBar.LineRightCommand}"/><Setter TargetName="IncreaseGlyph" Property="Text" Value="&#xE76C;"/>
     <Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ScrollChrome" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="14"/></Trigger></Style.Triggers>
 </Style>
</ResourceDictionary>
